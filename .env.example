# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# App Configuration
NEXT_PUBLIC_APP_URL=https://veri9.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@veri9.com

# USDA FoodData Central (Free - get key at https://fdc.nal.usda.gov/api-key-signup.html)
# Default DEMO_KEY works but limited to 30 requests/hour
USDA_API_KEY=DEMO_KEY

# Nutritionix API (Optional - free tier available at https://www.nutritionix.com/business/api)
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=

# EAN Search (Optional - free tier at https://www.ean-search.org/perl/api.pl)
# Without a token, requests are unauthenticated (rate-limited). With a token you
# get higher rate limits. Paid plans start at €19/mo for 5,000 lookups/month.
EAN_SEARCH_TOKEN=

# EAN-DB (Free 250 credits on sign-up — 404s don't cost a credit!)
# Sign up free at https://ean-db.com/auth — no credit card needed.
# After confirming email, copy your JWT from https://ean-db.com/account
# Excellent global coverage (Google product taxonomy categories, multi-language titles)
EAN_DB_JWT=

# Barcode Lookup (Paid - $30/mo for 35k requests at https://www.barcodelookup.com/api)
# Huge accuracy boost for US household / grocery / pharmacy items that free
# databases like OpenFoodFacts miss (e.g. Mrs Dash seasonings).
BARCODE_LOOKUP_API_KEY=

# Barcode Spider (Free 100 lookups/day — paid plans from $9.99/mo for more)
# Sign up at https://www.barcodespider.com/ and copy your Access Token.
# Covers 50M+ UPC/EAN products: groceries, electronics, clothing, etc.
# Excellent supplement to OpenFoodFacts for products not in its database.
BARCODE_SPIDER_TOKEN=

# Amazon Product Advertising API v5 (Free with Amazon Associates account)
# Sign up: https://affiliate-program.amazon.com/ then request PA-API access.
# Gives us access to the most comprehensive consumer catalog on the planet
# and is treated as a high-authority source that overrides conflicting
# crowd-sourced data (prevents Mrs Dash being identified as a Pokemon game).
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
# Optional — defaults to US marketplace
AMAZON_PAAPI_HOST=webservices.amazon.com
AMAZON_PAAPI_REGION=us-east-1

# Google Cloud Vision OCR (pay-as-you-go — first 1000/mo free)
# Enable the Vision API at https://console.cloud.google.com and create an
# API key restricted to "Cloud Vision API" only.
# Used for: (1) barcode fallback OCR, (2) 🖼️ Photo AI authentication tab
# Steps: console.cloud.google.com → APIs & Services → Library → Cloud Vision API → Enable
#        APIs & Services → Credentials → Create API Key → Restrict to Cloud Vision API
GOOGLE_VISION_API_KEY=

# ─── Payment Gateways (for Donations) ──────────────────────────────────────
# At least one gateway must be configured for the /donate page to accept payments.
# Funds go directly to your registered bank account at each gateway.

# Stripe — Global card payments (stripe.com)
# Get keys at: dashboard.stripe.com → Developers → API Keys
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Paystack — Nigeria, Ghana, Kenya, South Africa (paystack.com)
# Get keys at: app.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_PUBLIC_KEY=pk_live_xxx
PAYSTACK_SECRET_KEY=sk_live_xxx

# PayPal — Global (developer.paypal.com)
# Create a REST app at developer.paypal.com → My Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live

# Flutterwave — Africa (app.flutterwave.com)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxx
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST-xxx

# Google reCAPTCHA v2 — "I'm not a robot" checkbox
# Get your keys at https://www.google.com/recaptcha/admin (choose v2 checkbox)
# The values below are Google's public TEST keys — replace before going to production.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe